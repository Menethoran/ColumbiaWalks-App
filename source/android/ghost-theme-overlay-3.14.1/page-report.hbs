<script>
(function () {
    function openContactTab() {
        if (window.location.hash !== "#contact-us") return;
        var tab = document.getElementById("cw-feedback-tab");
        var panel = document.getElementById("cw-feedback-view");
        if (!tab || !panel) return;
        tab.click();
        window.setTimeout(function () {
            panel.scrollIntoView({behavior: "smooth", block: "start"});
        }, 0);
    }
    window.addEventListener("hashchange", openContactTab);
    window.addEventListener("DOMContentLoaded", openContactTab);
}());
</script>
