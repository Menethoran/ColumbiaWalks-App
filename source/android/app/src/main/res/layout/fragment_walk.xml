<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cw_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/walk_title"
            android:textColor="@color/cw_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/walk_intro"
            android:textColor="@color/cw_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@color/cw_surface_variant"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/walk_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/walk_status_ready"
                android:textColor="@color/cw_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/walk_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0.00 miles"
                android:textColor="@color/cw_blue"
                android:textSize="34sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/walk_start_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="52dp"
                android:text="@string/walk_start"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/walk_stop_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="@string/walk_stop"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/walk_consent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="48dp"
            android:text="@string/walk_consent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/walk_privacy"
            android:textColor="@color/cw_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/walk_health_title"
            android:textColor="@color/cw_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/walk_health_intro"
            android:textColor="@color/cw_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/walk_health_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="52dp"
            android:text="@string/walk_health_import"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
