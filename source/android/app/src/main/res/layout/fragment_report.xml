<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cw_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_title"
            android:textColor="@color/cw_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/report_intro"
            android:textColor="@color/cw_text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_continuous_report_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/continuous_open_description"
            android:minHeight="52dp"
            android:text="@string/continuous_open_from_report"
            android:textAllCaps="false"
            app:icon="@drawable/ic_repeat"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFF4DA"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/cw_gold"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/emergency_notice"
                android:textColor="@color/cw_text"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/report_path_title"
            android:textColor="@color/cw_blue_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/report_path_intro"
            android:textColor="@color/cw_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_report_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:checkable="true"
                android:text="@string/quick_report"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/full_report_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:checkable="true"
                android:text="@string/full_report"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/report_path_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_report_path_error"
            android:textColor="@color/cw_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/quick_report_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_complaint_optional"
                android:textColor="@color/cw_blue_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/quick_complaint_intro"
                android:textColor="@color/cw_text_secondary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/quick_crosswalk_encroachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/quick_crosswalk_encroachment" />

            <CheckBox
                android:id="@+id/quick_missing_sidewalk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/quick_missing_sidewalk" />

            <CheckBox
                android:id="@+id/quick_speeding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/quick_speeding" />

            <CheckBox
                android:id="@+id/quick_illegal_u_turn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/quick_illegal_u_turn" />

            <CheckBox
                android:id="@+id/quick_trip_hazard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/quick_trip_hazard" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_other_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/quick_other"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/full_report_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/issue_types"
            android:textColor="@color/cw_blue_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/issue_sidewalk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/sidewalk_safety" />

        <CheckBox
            android:id="@+id/issue_vehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/vehicle_safety" />

        <CheckBox
            android:id="@+id/issue_crosswalk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/crosswalk_safety" />

        <CheckBox
            android:id="@+id/issue_trip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/trip_hazards" />

        <CheckBox
            android:id="@+id/issue_aggressive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/aggressive_drivers" />

        <CheckBox
            android:id="@+id/issue_police"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/police_response" />

        <CheckBox
            android:id="@+id/issue_lighting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/lighting_visibility" />

        <CheckBox
            android:id="@+id/issue_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/accessibility" />

        <CheckBox
            android:id="@+id/issue_school_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/school_route_safety" />

        <CheckBox
            android:id="@+id/issue_other"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/other_issue" />

        <TextView
            android:id="@+id/issue_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_issue_error"
            android:textColor="@color/cw_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/detailed_checklist_title"
            android:textColor="@color/cw_blue_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/detailed_checklist_intro"
            android:textColor="@color/cw_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detailed_checklist_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F3F7F8"
            android:padding="12dp"
            android:text="@string/detailed_checklist_empty"
            android:textColor="@color/cw_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/detailed_checklist_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/subject_vehicle_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_identification_details"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/identification_expand"
                android:gravity="start|center_vertical"
                android:minHeight="48dp"
                android:text="@string/identification_collapsed"
                android:textAllCaps="false"
                android:textColor="@color/cw_blue_dark"
                android:textSize="18sp"
                app:icon="@android:drawable/arrow_down_float"
                app:iconGravity="textEnd"
                app:iconTint="@color/cw_blue_dark" />

            <LinearLayout
                android:id="@+id/identification_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/identification_notice"
                android:textColor="@color/cw_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/reported_party_question"
                android:textColor="@color/cw_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/reported_party_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/cw_blue"
                android:contentDescription="@string/reported_party_question"
                android:minHeight="52dp"
                android:paddingHorizontal="8dp" />

            <CheckBox
                android:id="@+id/vehicle_involved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/vehicle_involved" />

            <LinearLayout
                android:id="@+id/vehicle_details_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/vehicle_identification_title"
                    android:textColor="@color/cw_blue_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ColumbiaWalks.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/license_plate">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_license_plate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLength="20"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ColumbiaWalks.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/plate_state">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_plate_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLength="32"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ColumbiaWalks.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/vehicle_year">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_year"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="8"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ColumbiaWalks.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/vehicle_make">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_make"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLength="80"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ColumbiaWalks.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/vehicle_model">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_model"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLength="80"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ColumbiaWalks.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/vehicle_color">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_color"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLength="80"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ColumbiaWalks.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/vehicle_body_style">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_body_style"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLength="80"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ColumbiaWalks.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/vehicle_unit_number">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_unit_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLength="80"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ColumbiaWalks.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/vehicle_vin">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_vin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLength="32"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/emergency_lights_status"
                    android:textColor="@color/cw_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/emergency_lights_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/cw_blue"
                    android:contentDescription="@string/emergency_lights_status"
                    android:minHeight="52dp"
                    android:paddingHorizontal="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/siren_status"
                    android:textColor="@color/cw_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/siren_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/cw_blue"
                    android:contentDescription="@string/siren_status"
                    android:minHeight="52dp"
                    android:paddingHorizontal="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ColumbiaWalks.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/visible_damage">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_visible_damage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="500"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ColumbiaWalks.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/vehicle_description">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="1000"
                        android:minLines="4" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/police_interaction_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/police_interaction_title"
                android:textColor="@color/cw_blue_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/police_observation_notice"
                android:textColor="@color/cw_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/police_response_question"
                android:textColor="@color/cw_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/police_response_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/police_not_involved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minHeight="44dp"
                    android:text="@string/police_not_involved" />

                <RadioButton
                    android:id="@+id/police_good"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/police_good" />

                <RadioButton
                    android:id="@+id/police_bad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/police_bad" />

                <RadioButton
                    android:id="@+id/police_mixed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:text="@string/police_mixed" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/police_observations_title"
                android:textColor="@color/cw_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/police_observations_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.ColumbiaWalks.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/police_complaint_details">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/police_complaint_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="1500"
                    android:minLines="5" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/severity"
            android:textColor="@color/cw_blue_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/severity_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/cw_blue"
            android:contentDescription="@string/severity"
            android:minHeight="52dp"
            android:paddingHorizontal="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ColumbiaWalks.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="@string/observed_time">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/observed_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/additional_information_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:minHeight="48dp"
            android:text="@string/additional_information_toggle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/details_layout"
            style="@style/Widget.ColumbiaWalks.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/details_label"
            android:visibility="gone"
            app:counterEnabled="true"
            app:counterMaxLength="700"
            app:helperText="@string/details_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="700"
                android:minLines="5" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/report_photo_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/photo_optional"
            android:textColor="@color/cw_blue_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/photo_privacy_notice"
            android:textColor="@color/cw_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/take_photo_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/take_photo"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/choose_photo_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/choose_photo"
                android:textAllCaps="false" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/photo_preview_container"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/photo_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/photo_preview"
                android:scaleType="centerCrop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/remove_photo_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:backgroundTint="@color/white"
                android:text="@string/remove_photo"
                android:textAllCaps="false" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggle_report_location"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:contentDescription="@string/report_location_expand"
            android:gravity="start|center_vertical"
            android:minHeight="48dp"
            android:text="@string/report_location_collapsed"
            android:textAllCaps="false"
            android:textColor="@color/cw_blue_dark"
            android:textSize="18sp"
            app:icon="@android:drawable/arrow_down_float"
            app:iconGravity="textEnd"
            app:iconTint="@color/cw_blue_dark" />

        <LinearLayout
            android:id="@+id/report_location_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/report_location_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/map_location_default"
                android:textColor="@color/cw_text"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/report_location_source_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/location_source_waiting"
                android:textColor="@color/cw_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#F3F7F8"
                app:cardCornerRadius="8dp"
                app:strokeColor="#D7E1E6"
                app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nearest_intersection_title"
                    android:textColor="@color/cw_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nearest_intersection_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nearest_intersection_waiting"
                    android:textColor="@color/cw_blue_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/intersection_optional_note"
                    android:textColor="@color/cw_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/change_map_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/choose_on_map"
                android:textAllCaps="false" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/official_email_notice_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:importantForAccessibility="yes"
            android:visibility="gone"
            app:cardBackgroundColor="@color/cw_green_light"
            app:cardCornerRadius="8dp"
            app:strokeColor="@color/cw_green"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggle_official_email_details"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/official_email_expand"
                    android:gravity="start|center_vertical"
                    android:minHeight="48dp"
                    android:text="@string/official_email_optional_title"
                    android:textAllCaps="false"
                    android:textColor="@color/cw_text"
                    app:icon="@android:drawable/arrow_down_float"
                    app:iconGravity="textEnd"
                    app:iconTint="@color/cw_text" />

                <LinearLayout
                    android:id="@+id/official_email_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/official_email_notice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/official_email_disclosure_codes"
                        android:textColor="@color/cw_text"
                        android:textSize="14sp" />

                    <CheckBox
                        android:id="@+id/official_email_opt_in"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minHeight="48dp"
                        android:text="@string/official_email_opt_in" />

                    <TextView
                        android:id="@+id/official_email_requirements"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/official_email_opt_in_requirements"
                        android:textColor="@color/cw_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/official_email_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="assertive"
            android:textColor="@color/cw_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_report_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="@string/submit_to_cw"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_report_notify_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="@string/submit_to_cw_and_notify_cbpd"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/submit_notify_cbpd_disclosure"
            android:textColor="@color/cw_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notify_authorities_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/notify_authorities"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
