<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/cw_surface">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<com.google.android.material.button.MaterialButton android:id="@+id/police_tip_back" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/community_back" />
<TextView android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:text="@string/tip_title" android:textColor="@color/cw_text" android:textSize="26sp" />
<TextView android:textStyle="bold" android:background="@color/cw_gold" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:text="@string/tip_banner" android:textColor="@color/cw_text" android:textSize="17sp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:text="@string/tip_privacy" android:textColor="@color/cw_text" android:textSize="15sp" />
<TextView android:textStyle="bold" android:background="@color/cw_error_surface" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:text="@string/tip_emergency" android:textColor="@color/cw_text" android:textSize="15sp" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.ColumbiaWalks.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/tip_label_subject" app:helperText="@string/tip_limit_subject">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/tip_subject" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences|textNoSuggestions" android:importantForAutofill="no" android:maxLength="128" android:minLines="1" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.ColumbiaWalks.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/tip_label_observed_time" app:helperText="@string/tip_limit_observed_time">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/tip_observed_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences|textNoSuggestions" android:importantForAutofill="no" android:maxLength="500" android:minLines="1" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.ColumbiaWalks.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/tip_label_location" app:helperText="@string/tip_limit_location">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/tip_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences|textNoSuggestions" android:importantForAutofill="no" android:maxLength="500" android:minLines="1" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.ColumbiaWalks.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/tip_label_direction" app:helperText="@string/tip_limit_direction">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/tip_direction" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences|textNoSuggestions" android:importantForAutofill="no" android:maxLength="500" android:minLines="1" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.ColumbiaWalks.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/tip_label_license_plate" app:helperText="@string/tip_limit_license_plate">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/tip_license_plate" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences|textNoSuggestions" android:importantForAutofill="no" android:maxLength="500" android:minLines="1" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.ColumbiaWalks.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/tip_label_plate_state" app:helperText="@string/tip_limit_plate_state">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/tip_plate_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences|textNoSuggestions" android:importantForAutofill="no" android:maxLength="500" android:minLines="1" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.ColumbiaWalks.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/tip_label_vehicle_description" app:helperText="@string/tip_limit_vehicle_description">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/tip_vehicle_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences|textNoSuggestions" android:importantForAutofill="no" android:maxLength="500" android:minLines="1" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.ColumbiaWalks.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/tip_label_observation" app:helperText="@string/tip_limit_observation">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/tip_observation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences|textNoSuggestions" android:importantForAutofill="no" android:maxLength="5000" android:minLines="3" />
</com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.ColumbiaWalks.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="@string/tip_label_evidence_notes" app:helperText="@string/tip_limit_evidence_notes">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/tip_evidence_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="top|start" android:inputType="textMultiLine|textCapSentences|textNoSuggestions" android:importantForAutofill="no" android:maxLength="2000" android:minLines="3" />
</com.google.android.material.textfield.TextInputLayout>
<CheckBox android:id="@+id/tip_inactive" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/tip_inactive" android:textColor="@color/cw_text" />
<CheckBox android:id="@+id/tip_test_only" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/tip_test_only" android:textColor="@color/cw_text" />
<com.google.android.material.button.MaterialButton android:id="@+id/tip_prepare" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/tip_prepare_action" android:textAllCaps="false" />
<TextView android:id="@+id/tip_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:accessibilityLiveRegion="polite" android:textColor="@color/cw_blue_dark" android:textSize="17sp" android:textStyle="bold" />
<TextView android:id="@+id/tip_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:background="@color/cw_surface_variant" android:textColor="@color/cw_text" android:textSize="16sp" android:visibility="gone" />
<com.google.android.material.button.MaterialButton android:id="@+id/tip_submit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/tip_submit_action" android:textAllCaps="false" android:visibility="gone" />
<com.google.android.material.button.MaterialButton android:id="@+id/tip_new" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/tip_new_action" android:textAllCaps="false" android:visibility="gone" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
